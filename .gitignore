# Segreti: solo .env.example va versionato.
# `.env.*` copre anche i file che nascono accanto al .env — il backup che
# `scripts/prepara-env.sh --forza` lascia in `.env.precedente`, e le copie
# che si fanno a mano. Senza, quel backup sarebbe tracciabile: quattro
# segreti in chiaro a un `git add -A` di distanza dal repository.
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# Residui di setuptools: `pip install .` li lascia nell'albero di lavoro.
build/
dist/
.eggs/

# Frontend
node_modules/
frontend/dist/
frontend/.vite/

# Build servito da FastAPI: prodotto, non sorgente
backend/static/

# Stato locale
*.log
.DS_Store
