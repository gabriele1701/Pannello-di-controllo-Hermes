#!/usr/sbin/nft -f
#
# Egress dello scanner VSPT — regole HOST-SIDE, nel forward path.
#
# NON si applica da sola: i due `define` (subnet della rete `uscita` e IP di
# host:22) li fornisce assess/net/applica-nftables.sh, che legge
# VSPT_SUBNET_USCITA / VSPT_HOST_SSH e li antepone a questo file. Il file resta
# parametrico: nessun IP inventato qui dentro.
#
# Perche' host-side e per SUBNET (non per IP per-container)
# --------------------------------------------------------
# Le regole stanno sull'HOST della VM, nel forward path — il piano dove Docker
# instrada il traffico container->esterno. Filtrano per la SUBNET della rete
# `uscita` (valore fisso dal compose, ipam), non per l'IP del singolo container,
# che cambia a ogni `up`. La policy NON e' un drop globale (spezzerebbe ogni
# forwarding dell'host): si lascia passare cio' che NON viene dalla subnet
# uscita, e per cio' che ne viene si concede SOLO host:22, established/related e
# DNS; tutto il resto e' DROP. L'enforcement vive qui, non in un if di Python.
#
# Caveat: backend nftables di Docker (Docker 29)
# ----------------------------------------------
# Docker 29 usa il backend nftables e crea catene proprie (es. `ip docker`,
# `inet docker-bridge`) con i suoi hook. Questa tabella e' SEPARATA
# (`ip assess_egress`) con un hook forward a priorita' NEGATIVA: gira PRIMA
# delle catene di Docker, e un `drop` e' terminale (ferma l'intera valutazione),
# quindi vince anche se Docker piu' avanti riaccettasse. Due conseguenze
# pratiche per l'operatore:
#   * un restart del demone o un `docker network` puo' ricreare le reti: se la
#     subnet di `uscita` cambia, RIAPPLICARE (applica-nftables.sh e' idempotente);
#   * l'SSH verso l'host passa spesso per l'INPUT dell'host (destinazione = il
#     gateway della rete), non per il forward: in quel caso la regola host:22 qui
#     e' innocua e la restrizione che conta resta il DROP dell'uscita verso
#     Internet. Se invece host:22 e' raggiunto via forward, la regola lo permette.
#
# Famiglia `ip` (solo IPv4): la rete `uscita` e' IPv4 (ipam /24). Tenendo la
# tabella in famiglia `ip`, i pacchetti IPv6 forwardati dall'host NON entrano in
# questa catena e non vengono toccati: nessun effetto collaterale sul resto.

table ip assess_egress {
    chain forward {
        type filter hook forward priority -5; policy accept;

        # Solo il traffico ORIGINATO dalla subnet `uscita` dello scanner ci
        # riguarda. Tutto il resto prosegue: non e' compito di queste regole.
        ip saddr != $SUBNET_USCITA accept

        # Da qui in poi: sorgente DENTRO la subnet uscita.

        # Connessioni gia' stabilite e il loro traffico di ritorno.
        ct state established,related accept

        # DNS: risoluzione dei nomi verso un resolver raggiungibile.
        udp dport 53 accept
        tcp dport 53 accept

        # L'UNICA destinazione applicativa consentita in uscita: host:22 (SSH).
        ip daddr $HOST_SSH tcp dport 22 accept

        # Tutto il resto dalla subnet uscita e' negato: nessuna uscita verso
        # Internet. Si logga il drop per diagnosi (rate dal kernel).
        log prefix "assess_egress_drop " level info drop
    }
}
