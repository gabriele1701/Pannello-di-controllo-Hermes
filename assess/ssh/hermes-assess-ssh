#!/usr/bin/env python3
"""Drop-in ForceCommand per l'utente SSH `assess` (SCRITTO, non installato).

sshd lo invoca per ogni connessione della chiave di `assess`; legge
$SSH_ORIGINAL_COMMAND e lascia passare solo i comandi diagnostici consentiti
(vedi assess/ssh/validatore.py).

Installazione sul server (venerdi', a mano — vedi README-assess.md):
  - copiare il package assess/ sotto /opt/pannello (o ovunque sia PYTHONPATH);
  - in ~assess/.ssh/authorized_keys:
      restrict,command="/usr/bin/env PYTHONPATH=/opt/pannello python3 \
        /opt/pannello/assess/ssh/hermes-assess-ssh" ssh-ed25519 AAAA... assess
  - l'account `assess` non privilegiato, nessun sudo.
"""

import sys

from assess.ssh.validatore import main

if __name__ == "__main__":
    sys.exit(main())
