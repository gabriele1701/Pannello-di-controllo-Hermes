# Modello delle variabili d'ambiente. Copiare in .env e riempire.
#
#     cp .env.example .env
#
# .env e' in .gitignore: nessun valore reale entra nel repository.
# Nessuna di queste variabili ha un default funzionante nel compose: se
# manca, l'avvio FALLISCE. Un default che funziona e' un default che resta,
# e una password di database che resta e' una password nota.

# --- Database -------------------------------------------------------------- #
# Password dell'utente del database. Obbligatoria, nessun default.
# Generarla: openssl rand -base64 32
POSTGRES_PASSWORD=sostituiscimi-con-una-password-generata

# Nome utente e database. Hanno un default nel compose perche' non sono
# segreti: conoscerli non da' accesso a niente.
POSTGRES_USER=hermes
POSTGRES_DB=hermes_panel

# --- Applicazione ---------------------------------------------------------- #
# Chiave di firma del cookie di sessione. Obbligatoria, nessun default.
# Ruotarla invalida tutte le sessioni aperte, che e' il comportamento voluto.
# Generarla: openssl rand -hex 32
APP_SECRET_KEY=sostituiscimi-con-32-byte-esadecimali-generati

# "production" attiva il flag Secure sul cookie, che lo rende inviabile solo
# su HTTPS. In "development" resta disattivo, altrimenti il login su
# http://localhost non funzionerebbe.
APP_ENV=development

# --- Operatore iniziale ---------------------------------------------------- #
# Credenziali del primo e unico operatore, create dal seed al primo avvio.
# La password viene salvata come hash argon2: il valore in chiaro non resta
# da nessuna parte dopo il seed.
HERMES_ADMIN_USERNAME=operatore
HERMES_ADMIN_PASSWORD=sostituiscimi-prima-del-primo-avvio
