# Modello delle variabili d'ambiente. Non va copiato a mano: lo legge
# `scripts/prepara-env.sh`, che ne ricava `.env` generando i segreti.
#
#     ./scripts/prepara-env.sh
#
# Questo file resta la documentazione di cosa serve e perche': ogni
# variabile e' spiegata qui sotto. Se ne compare una nuova col valore
# `sostituiscimi`, lo script se ne accorge e si ferma invece di scrivere un
# .env incompleto.
#
# .env e' in .gitignore: nessun valore reale entra nel repository.
# Nessuna di queste variabili ha un default funzionante nel compose: se
# manca, l'avvio FALLISCE. Un default che funziona e' un default che resta,
# e una password di database che resta e' una password nota.

# --- Database -------------------------------------------------------------- #
# Password del ruolo proprietario del database. Obbligatoria, nessun default.
#
# Generarla:  openssl rand -hex 32
#
# Esadecimale e non base64: questa password finisce dentro un URL di
# connessione, e in un URL alcuni caratteri hanno un significato. Una `@`
# romperebbe l'URL (separa le credenziali dall'host); una `/`, che
# `openssl rand -base64` produce nel 40% dei casi, e' accettata
# dall'applicazione ma non da tutti gli strumenti che leggono lo stesso URL.
# L'esadecimale non ha caratteri speciali e ha la stessa entropia a parita'
# di byte generati.
POSTGRES_PASSWORD=sostituiscimi-con-una-password-generata

# Nome utente e database del ruolo PROPRIETARIO delle tabelle. Hanno un
# default nel compose perche' non sono segreti: conoscerli non da' accesso a
# niente.
#
# Questo ruolo lo usano SOLO le migrazioni e il seed. L'applicazione in
# esercizio usa un ruolo diverso, vedi sotto.
POSTGRES_USER=hermes
POSTGRES_DB=hermes_panel

# Password del ruolo `hermes_app`, quello con cui gira l'applicazione.
# Obbligatoria, nessun default.
# Generarla: openssl rand -hex 32   (esadecimale, per la ragione sopra)
#
# Perche' due ruoli: il proprietario di una tabella in PostgreSQL puo'
# disabilitarne i trigger con `ALTER TABLE ... DISABLE TRIGGER ALL`. Gli
# invarianti di questo progetto (la monotonia del tier, l'append-only sul
# log) SONO trigger. Se l'applicazione si connettesse come proprietario,
# avrebbe a disposizione il comando che disattiva i propri controlli di
# sicurezza -- e con lei qualunque difetto del suo codice.
#
# `hermes_app` non possiede niente, non e' superutente, e ha le concessioni
# minime: sola lettura su `tools` e su `audit_events`, nessun UPDATE o DELETE
# su `tier_overrides`, e UPDATE su una sola colonna di `scope_consents`.
HERMES_APP_DB_PASSWORD=sostituiscimi-con-una-password-generata

# --- Applicazione ---------------------------------------------------------- #
# Chiave di firma del cookie di sessione. Obbligatoria, nessun default.
# Ruotarla invalida tutte le sessioni aperte, che e' il comportamento voluto.
# Generarla: openssl rand -hex 32
APP_SECRET_KEY=sostituiscimi-con-32-byte-esadecimali-generati

# "production" attiva il flag Secure sul cookie, che lo rende inviabile solo
# su HTTPS. In "development" resta disattivo, altrimenti il login su
# http://localhost non funzionerebbe.
APP_ENV=development

# --- Operatore iniziale ---------------------------------------------------- #
# Credenziali del primo e unico operatore, create dal seed al primo avvio.
# La password viene salvata come hash argon2: il valore in chiaro non resta
# da nessuna parte dopo il seed.
HERMES_ADMIN_USERNAME=operatore
HERMES_ADMIN_PASSWORD=sostituiscimi-prima-del-primo-avvio
